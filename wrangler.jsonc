{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackbox",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-03",
  "containers": [{
    "class_name": "BlackboxContainer",
    "image": "./Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {"bindings": [{"name": "BLACKBOX", "class_name": "BlackboxContainer"}]},
  "exports": {"BlackboxContainer": {"type": "durable-object", "storage": "sqlite"}},
  "observability": {"enabled": true}
}
